<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Idiomatic, Native-AOT-compatible C# binding for Google Filament (real-time physically based rendering engine).</Description>
    <Authors>FilamentSharp contributors</Authors>
    <Copyright>Copyright (c) 2026 FilamentSharp contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://example.invalid/filamentsharp</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FilamentSharp.UnitTests" />
    <InternalsVisibleTo Include="FilamentSharp.IntegrationTests" />
  </ItemGroup>

</Project>
