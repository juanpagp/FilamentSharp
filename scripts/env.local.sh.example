# Copy to scripts/env.local.sh and adapt for your machine (env.local.sh is
# Git-ignored). It is sourced by scripts/env.sh and may override anything
# documented there.
#
# Example: user-local clang + libc++ toolchain (no system-wide install):
#
#   export CXX="$HOME/tools/clang-root/usr/lib/llvm-19/bin/clang++"
#   export FILAMENTSHARP_LIBCXX_INCLUDE="$HOME/tools/clang-root/usr/include/c++/v1"
#   export FILAMENTSHARP_LIBCXX_LIB="$HOME/tools/clang-root/usr/lib/llvm-19/lib"
#   export FILAMENTSHARP_EXTRA_LD_LIBRARY_PATH="$HOME/tools/clang-root/usr/lib/llvm-19/lib"
#
# Example: use a self-built Filament instead of the pinned release SDK:
#
#   export FILAMENT_SDK_DIR="$HOME/builds/filament-install"
#
# Example: force a specific system Vulkan ICD:
#
#   export VK_ICD_FILENAMES="/etc/vulkan/icd.d/nvidia_icd.x86_64.json"
