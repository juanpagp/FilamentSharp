deps-cache/

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx

# Local environment overrides (machine-specific paths, secrets)
scripts/env.local.sh

# Temporary files
*.tmp
*.log

# Sample run outputs (written to the working directory by samples)
*.ppm

# NuGet package output (created by scripts/pack.sh)
artifacts/
